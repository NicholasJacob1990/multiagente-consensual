{
  "name": "@nicholasjacob90/a2a-mesh",
  "version": "1.3.0",
  "description": "Mesh A2A local, bridge MCP e painel web para oito agentes CLI, com seleção de equipe.",
  "type": "module",
  "bin": {
    "a2a-mesh": "npm/cli.mjs",
    "a2a-mesh-mcp": "runtime/a2a-shared/mesh-bridge-mcp.js"
  },
  "files": [
    "npm/",
    "runtime/",
    "!runtime/a2a-claude/.playwright-mcp/",
    "!runtime/a2a-claude/*.png",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepack": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "node-pty": "^1.1.0"
  },
  "keywords": [
    "a2a",
    "mcp",
    "multi-agent",
    "codex",
    "claude",
    "gemini",
    "grok",
    "qwen",
    "cursor",
    "dashboard"
  ],
  "author": "Nicholas Jacob",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
