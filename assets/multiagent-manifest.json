{
  "manifest_version": 1,
  "plugin_version": "1.9.1",
  "contract": "multiagent_local_v1",
  "policy": "strict",
  "fallback": "pause_and_report",
  "source_of_truth": true,
  "filesystem": {
    "contract": "scoped_full_tools_v2",
    "default_policy": "project_root_plus_explicit_directories",
    "directory_scope": "explicit_per_invocation",
    "implicit_home_scope": false,
    "home_scope_requires_explicit_opt_in": true,
    "full_tool_permissions_within_host_identity": true,
    "os_security_boundary": false,
    "can_read": true,
    "can_create": true,
    "can_modify": true,
    "can_delete": true,
    "auto_approve_local_tools": true,
    "canonical_write_requires_resolved_role": true,
    "destructive_actions_require_task_scope": true,
    "external_side_effects_require_task_scope": true
  },
  "provenance": {
    "contract": "multiagent_provenance_v1",
    "attestation": "host_hmac_v1",
    "nonce_ledger": "multiagent_nonce_ledger_v1",
    "receipt_requires_real_artifact_hash": true,
    "receipt_requires_observed_model": true,
    "receipt_requires_confirmed_native_session_or_isolated_execution": true,
    "strict_consensus_requires_one_receipt_per_seat_per_stability_evaluation": true,
    "replay_is_fail_closed": true,
    "secrets_removed_from_child_environment": true,
    "same_user_unrestricted_shell_is_cryptographic_boundary": false
  },
  "identity_policy": {
    "canonical_external_seats": ["claude", "codex", "gemini", "grok", "kimi", "opencode", "glm", "deepseek", "qwen"],
    "aliases_never_create_independent_seats": true,
    "local_persona_homonyms_count_as_external_seat": false,
    "route_provider_and_fixed_model_must_match_manifest": true,
    "silent_substitution": false
  },
  "state": {
    "canonical_root": "$HOME/.agents/runs",
    "legacy_read_roots": [
      "$HOME/.claude/loops/runs"
    ]
  },
  "native_sessions": {
    "contract": "native_session_mirror_v1",
    "default_persist": false,
    "request_fields": ["persistir_sessoes_nativas", "persist_native_session"],
    "scope": "one_session_per_invocation",
    "central_history_is_canonical": true,
    "native_history_is_mirror_only": true,
    "native_history_never_proves_consensus": true,
    "report_requested_effective_and_confirmed": true,
    "on_unconfirmed": "report_without_silent_success",
    "routes": {
      "claude": {"mode": "explicit_session_id", "discoverable": true},
      "codex": {"mode": "persistent_exec_json_receipt", "discoverable": true},
      "gemini": {"mode": "explicit_session_id", "discoverable": true},
      "antigravity": {"mode": "native_default", "discoverable": false},
      "cursor": {"mode": "precreated_chat", "discoverable": true},
      "opencode": {"mode": "unique_title_lookup", "discoverable": true},
      "kimi": {"mode": "native_default", "discoverable": false}
    }
  },
  "durable_execution": {
    "contract": "durable_execution_v1",
    "default_profile": "standard",
    "opt_in_profile": "durable_5d_v1",
    "clock": "elapsed_wall_time",
    "max_elapsed_seconds": 432000,
    "offline_counts_toward_deadline": true,
    "per_call_timeout_seconds": 1800,
    "per_call_exception_max_seconds": 3600,
    "checkpoint_write": "atomic",
    "checkpoint_after": ["call", "round", "cycle", "version", "node", "wave", "join"],
    "resume_after_process_or_host_restart": true,
    "idempotency": "event_id+input_sha256",
    "canonical_state_root": "$HOME/.agents/runs",
    "budget_scopes": ["daily", "total"],
    "stop_conditions": [
      "success",
      "two_cycles_without_measurable_progress",
      "material_blocker",
      "cancellation",
      "cost_limit",
      "call_limit",
      "deadline"
    ],
    "silent_route_or_model_substitution": false
  },
  "routes": {
    "claude": {"binary": "claude", "host": "claude-code", "filesystem_control": {"mode": "bypass_permissions", "access": "full_tools_host_identity", "directory_scope": "explicit_advisory", "auto_approve": true}, "output_control": {"mode": "native_route_ceiling", "max_output_tokens_flag": null}},
    "codex": {"binary": "codex", "host": "codex", "filesystem_control": {"mode": "danger_full_access", "access": "full_tools_host_identity", "directory_scope": "explicit_advisory", "auto_approve": true}, "output_control": {"mode": "native_route_ceiling", "max_output_tokens_flag": null}},
    "gemini": {"binary": "gemini", "host": "gemini-cli", "filesystem_control": {"mode": "yolo", "access": "full_tools_host_identity", "directory_scope": "explicit_advisory", "auto_approve": true}, "output_control": {"mode": "native_route_ceiling", "max_output_tokens_flag": null}},
    "antigravity": {"binary": "agy", "host": "antigravity-cli", "filesystem_control": {"mode": "bypass_permissions", "access": "full_tools_host_identity", "directory_scope": "explicit_advisory", "auto_approve": true}, "output_control": {"mode": "native_route_ceiling", "max_output_tokens_flag": null}},
    "cursor": {"binary": "cursor-agent", "host": "cursor-cli", "filesystem_control": {"mode": "force_sandbox_disabled", "access": "full_tools_host_identity", "directory_scope": "explicit_advisory", "auto_approve": true}, "output_control": {"mode": "native_route_ceiling", "max_output_tokens_flag": null}},
    "opencode": {"binary": "opencode", "host": "opencode-cli", "filesystem_control": {"mode": "auto_allow_all", "access": "full_tools_host_identity", "directory_scope": "explicit_advisory", "auto_approve": true}, "output_control": {"mode": "native_route_ceiling", "max_output_tokens_flag": null}},
    "kimi": {"binary": "kimi-secure", "host": "kimi-code-cli", "filesystem_control": {"mode": "config_auto_prompt", "access": "full_tools_host_identity", "directory_scope": "explicit_advisory", "auto_approve": true}, "output_control": {"mode": "native_route_ceiling", "max_output_tokens_flag": null}}
  },
  "seats": {
    "claude": {"route": "claude", "provider": "anthropic", "default_model": "claude-opus-5", "model_policy": "fixed_default", "aliases": ["opus", "opus-5", "claude-opus", "claude-opus-5"]},
    "codex": {"route": "codex", "provider": "openai", "default_model": "gpt-5.6-sol", "default_effort": "xhigh", "model_policy": "fixed_default", "aliases": ["gpt-5.6-sol"]},
    "gemini": {"route": "antigravity", "provider": "google", "default_model": "gemini-3.7-flash-high", "model_policy": "preserve_requested", "aliases": ["gemini-3.7", "gemini-3.7-flash-high"]},
    "antigravity": {"route": "antigravity", "provider": "google", "default_model": "gemini-3.7-flash-high", "model_policy": "preserve_requested", "aliases": ["agy", "gemini-3.7-antigravity"]},
    "grok": {"route": "cursor", "provider": "xai", "default_model": "cursor-grok-4.6-high", "model_policy": "fixed_default", "aliases": ["grok-4.6-high", "cursor-grok-4.6-high"]},
    "kimi": {"route": "kimi", "provider": "opencode-go", "upstream_model_family": "moonshot/kimi", "default_model": "kimi-code/k3", "default_effort": "max", "effort_policy": "fixed_max", "context_window_tokens": 1048576, "model_policy": "preserve_requested", "aliases": ["kimi-k3", "k3"]},
    "opencode": {"route": "opencode", "provider": "opencode-go", "default_model": "opencode-go/glm-5.3", "model_policy": "preserve_requested", "aliases": ["opencode"]},
    "glm": {"route": "opencode", "provider": "opencode-go", "default_model": "opencode-go/glm-5.3", "default_effort": "max", "effort_policy": "fixed_max", "model_policy": "fixed_default", "aliases": ["glm-5.3", "opencode-go/glm-5.3"]},
    "deepseek": {"route": "opencode", "provider": "opencode-go", "default_model": "opencode-go/deepseek-v4-pro", "default_effort": "max", "effort_policy": "fixed_max", "model_policy": "fixed_default", "aliases": ["deepseek-v4-pro", "opencode-go/deepseek-v4-pro"]},
    "qwen": {"route": "opencode", "provider": "opencode-go", "default_model": "opencode-go/qwen3.8-max", "default_effort": "max", "effort_policy": "fixed_max", "model_policy": "fixed_default", "aliases": ["qwen-coder", "qwen3.8-max", "opencode-go/qwen3.8-max"]}
  },
  "consensus": {
    "contract": "veredito_consenso_v1",
    "modes": ["estrito", "com_decisor", "consultivo", "desativado"],
    "policies": ["sempre", "se_necessario", "apenas_primeira", "nenhum"],
    "outcomes": ["consenso", "decisao_sem_consenso", "consultivo", "sem_consenso", "desativado"],
    "stable_evaluations_default": 2,
    "stable_evaluations_minimum_for_approval": 2,
    "nonce_ledger_default": "~/.agents/multiagent-state/nonces.json",
    "check_only_rejects_consumed_nonces": true,
    "receipt_round_must_match_evaluation_number": true,
    "rounds_default": 8,
    "rounds_recommended_max": 18,
    "rounds_max": 36,
    "cycles_default": 2,
    "cycles_recommended_max_per_seat": 6,
    "cycles_max_per_seat": 12,
    "phases_per_cycle": 3,
    "auto_extend_if_needed": true,
    "extension_increment_rounds": 3,
    "extension_increment_cycles": 1,
    "extension_requires": ["material_blocker_open", "measurable_progress"],
    "no_progress_cycles_before_stop": 2,
    "simulation_can_issue_verdict": false,
    "selection_is_approval": false,
    "approval_requires_real_artifact_and_signed_receipts": true,
    "one_round_is_provisional": true,
    "strict_holdout_fail_closed": true,
    "approved_state": "canonico_aprovado",
    "selected_state": "canonico_selecionado"
  },
  "collegiate_decision": {
    "contract": "decisao_colegiada_v1",
    "analytic_schema": "decisao_colegiada_v2",
    "tally_methods": ["global", "analitico", "hibrido"],
    "default_tally_method": "global",
    "analytic_dependency_graph": "single_parent_forest",
    "analytic_max_reachable_worlds": 4096,
    "hybrid_confirmation_policy": "bloqueante",
    "modalities": ["seriatim", "per_curiam", "opinion_of_court"],
    "default_modality": "opinion_of_court",
    "result_rules": ["unanimidade", "maioria_simples", "maioria_qualificada", "consenso_estrito", "com_decisor"],
    "default_result_rule": "maioria_simples",
    "calculation_bases": ["votos_validos", "cadeiras_ativas"],
    "default_calculation_base": "votos_validos",
    "join_scopes": ["dispositivo", "proposicao", "secao"],
    "default_join_scope": "proposicao",
    "separate_opinion_types": ["concorrente", "dissidente", "concordancia_apenas_resultado", "abstencao"],
    "separate_opinion_policies": ["publicar", "registrar_em_recibo", "nao_aplicavel"],
    "ratio_statuses": ["unificada", "pluralidade", "somente_resultado", "nao_aplicavel"],
    "per_curiam_author": "institucional_impessoal",
    "opinion_of_court_authors": ["maioria_nomeada", "relator_da_maioria"],
    "seriatim_requires_individual_votes": true,
    "opinion_of_court_requires_majority_join": true,
    "preserve_dissent_in_audit": true,
    "majority_is_consensus": false,
    "new_hash_invalidates_decision": true,
    "proclamation_freezes_votes": true,
    "strong_gate_requires_attested_votes_or_nested_consensus": true,
    "strong_gate_requires_real_artifact": true,
    "nonce_consumption_after_full_formation_validation": true,
    "trust_levels": [
      "formation_only",
      "attested_vote_formation",
      "nested_consensus_proof"
    ]
  },
  "output": {
    "contract": "adaptive_output_v1",
    "default_policy": "adaptive_up_to_native_max",
    "policies": ["adaptive_up_to_native_max", "concise_soft_target"],
    "native_route_limit_is_ceiling": true,
    "force_fill": false,
    "global_max_output_tokens": null,
    "phase_word_targets_are_soft": true,
    "explicit_user_limit_precedence": true,
    "unknown_limit_behavior": "report_native_route_default",
    "continuation": {
      "on_incomplete_required_artifact": "continue_same_seat",
      "max_segments_default": 8,
      "clean_boundary": "section_or_file",
      "approval_requires_complete_output": true
    }
  },
  "commands": {
    "a2a-status": {"entrypoint": "workflow-agentes", "profile": "a2a_status", "execution": "external_mcp", "approval_ceiling": "none"},
    "a2a-call": {"entrypoint": "workflow-agentes", "profile": "a2a_call", "execution": "external_mcp", "approval_ceiling": "none"},
    "a2a-broadcast": {"entrypoint": "workflow-agentes", "profile": "a2a_broadcast", "execution": "external_mcp", "approval_ceiling": "none"},
    "a2a-team": {"entrypoint": "workflow-agentes", "profile": "a2a_team", "execution": "external_mcp", "approval_ceiling": "none"},
    "a2a-debate": {"entrypoint": "consenso", "profile": "a2a_debate", "execution": "external_mcp", "approval_ceiling": "consultivo"},
    "a2a-consensus": {"entrypoint": "consenso", "profile": "a2a_consensus", "execution": "external_mcp", "approval_ceiling": "consultivo"},
    "a2a-ensemble": {"entrypoint": "loop-debate-agentes", "profile": "a2a_ensemble", "execution": "external_mcp", "approval_ceiling": "candidate_only"},
    "council": {"entrypoint": "consenso", "profile": "agent_council", "execution": "native_skill", "approval_ceiling": "consultivo"},
    "council-high": {"entrypoint": "consenso", "profile": "council_high", "execution": "native_skill", "approval_ceiling": "consultivo"},
    "llm-council": {"entrypoint": "consenso", "profile": "llm_council", "execution": "native_skill", "approval_ceiling": "consultivo"},
    "multi-debate": {"entrypoint": "consenso", "profile": "multi_debate", "execution": "external_mcp", "approval_ceiling": "consultivo"},
    "pal-council": {"entrypoint": "consenso", "profile": "pal_council", "execution": "external_mcp", "approval_ceiling": "consultivo"},
    "sage-debate": {"entrypoint": "consenso", "profile": "sage_debate", "execution": "external_mcp", "approval_ceiling": "consultivo"},
    "consenso": {"entrypoint": "consenso", "profile": "consenso_v1", "execution": "canonical", "approval_ceiling": "configured"},
    "loop-debate-agentes": {"entrypoint": "loop-debate-agentes", "profile": "debate_agents_v1", "execution": "canonical", "approval_ceiling": "configured"},
    "redacao-juridica-consensual": {"entrypoint": "loop-debate-agentes", "profile": "juridico_consensual_v2", "execution": "domain_profile", "approval_ceiling": "configured"},
    "workflow-agentes": {"entrypoint": "workflow-agentes", "profile": "workflow_agents_v1", "execution": "canonical", "approval_ceiling": "candidate_only"},
    "pipeline-agentes": {"entrypoint": "workflow-agentes", "profile": "pipeline_serial_v1", "execution": "alias", "approval_ceiling": "candidate_only"},
    "dag-agentes": {"entrypoint": "workflow-agentes", "profile": "dag_assincrono_v1", "execution": "alias", "approval_ceiling": "candidate_only"},
    "swarm-agentes": {"entrypoint": "workflow-agentes", "profile": "swarm_dinamico_v1", "execution": "alias", "approval_ceiling": "candidate_only"},
    "map-reduce-agentes": {"entrypoint": "workflow-agentes", "profile": "map_reduce_v1", "execution": "alias", "approval_ceiling": "candidate_only"},
    "torneio-agentes": {"entrypoint": "workflow-agentes", "profile": "torneio_eliminatorio_v1", "execution": "alias", "approval_ceiling": "candidate_only"},
    "votacao-agentes": {"entrypoint": "workflow-agentes", "profile": "votacao_multiagente_v1", "execution": "alias", "approval_ceiling": "candidate_only"},
    "roteamento-adaptativo": {"entrypoint": "workflow-agentes", "profile": "roteamento_adaptativo_v1", "execution": "alias", "approval_ceiling": "candidate_only"},
    "council-list": {"entrypoint": "consenso", "profile": "council_list", "execution": "native_skill", "approval_ceiling": "none"},
    "council-replay": {"entrypoint": "consenso", "profile": "council_replay", "execution": "native_skill", "approval_ceiling": "none"},
    "council-revisit": {"entrypoint": "consenso", "profile": "council_revisit", "execution": "native_skill", "approval_ceiling": "consultivo"},
    "council-outcome": {"entrypoint": "consenso", "profile": "council_outcome", "execution": "native_skill", "approval_ceiling": "none"},
    "multiagente": {"entrypoint": "multiagente", "profile": "adaptive_router_v1", "execution": "router", "approval_ceiling": "configured"},
    "bridge-agentes": {"entrypoint": "bridge-agentes", "profile": "cowork_transport_v1", "execution": "transport", "approval_ceiling": "none"}
  },
  "external_profiles": {
    "agent_council": {"session_proof": null, "model_holdout_proof": null, "blind": false},
    "council_high": {"session_proof": null, "model_holdout_proof": null, "blind": false},
    "llm_council": {"session_proof": null, "model_holdout_proof": null, "blind": false},
    "external_mcp": {"session_proof": null, "model_holdout_proof": null, "blind": false}
  },
  "legacy": {
    "routing_file": "$HOME/.agents/model-routing.yaml",
    "routing_file_role": "generated_compatibility_view",
    "read_old_runs": true,
    "write_legacy_mirrors": true,
    "mirror_fields": ["motor", "escritor", "estrategia", "alvo", "piso", "painel"]
  }
}
